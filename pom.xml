<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>jugistanbul</groupId>
    <artifactId>kafka-with-microservices</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <url>https://github.com/hakdogan/kafka-with-microservices</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <difc.kafka.clients.jar>${maven.multiModuleProjectDirectory}/../difc-for-kafka/security/policy-agent/signed-jars/kafka-clients-4.0.0.jar</difc.kafka.clients.jar>
        <difc.kafka.streams.jar>${maven.multiModuleProjectDirectory}/../difc-for-kafka/security/policy-agent/signed-jars/kafka-streams-4.0.0.jar</difc.kafka.streams.jar>
    </properties>

    <modules>
        <module>serde</module>
        <module>difc-support</module>
        <module>order-service</module>
        <module>stock-service</module>
        <module>validation-service</module>
        <module>payment-service</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>4.0.0</version>
            <scope>system</scope>
            <systemPath>${difc.kafka.clients.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.openliberty</groupId>
            <artifactId>openliberty-runtime</artifactId>
            <version>23.0.0.6</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
            <version>2.0.9</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
        </plugins>
    </build>
</project>
